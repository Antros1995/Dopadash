# Copia questo file come .dev.vars soltanto per lo sviluppo locale.
# Non inserire mai .dev.vars nel controllo versione.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_WEBHOOK_SECRET="YOUR_TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_ALLOWED_USER_ID="YOUR_TELEGRAM_USER_ID"
TELEGRAM_ALLOWED_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
MICROSOFT_CLIENT_ID="YOUR_MICROSOFT_CLIENT_ID"
MICROSOFT_CLIENT_SECRET="YOUR_MICROSOFT_CLIENT_SECRET"
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:8787/oauth/microsoft/callback"
MICROSOFT_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_32_BYTE_KEY"
GOOGLE_HEALTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_HEALTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GOOGLE_HEALTH_REDIRECT_URI="http://localhost:8787/oauth/fitbit/callback"
GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_32_BYTE_KEY"

# API desktop: il browser invia la sessione Supabase; il Worker la verifica.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
DESKTOP_SUPABASE_USER_ID="YOUR_SUPABASE_AUTH_USER_UUID"
DESKTOP_ALLOWED_ORIGINS="http://localhost:7358"
