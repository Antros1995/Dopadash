{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_PROVIDER": "openai",
    "AI_MODEL": "gpt-5.6-luna",
    "AI_MAX_OUTPUT_TOKENS": "1200",
    "AI_TIMEOUT_MS": "25000",
    "SAFE_MODE": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PERSONAL_AGENT",
        "class_name": "PersonalAgentV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_sqlite_classes": ["PersonalAgentV2"]
    }
  ],
  "ratelimits": [
    {
      "name": "TELEGRAM_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
